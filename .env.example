# =============================================================================
# Variáveis de ambiente — copie para .env (local) e cadastre na Vercel.
# NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.
# =============================================================================

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Supabase — chave pública (login no navegador)
SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# (igual à de cima, formato Next) (front-end, se necessário)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Google Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-aqui-a-chave-do-gemini

# Segredo para proteger a rota de processamento (cron)
CRON_SECRET=gere-um-segredo-longo-e-aleatorio
